# ============================================================
#  Local settings (testing). On Railway set these as Variables.
# ============================================================

# ---- App ----
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000
DEFAULT_LANG=ar
SESSION_DAYS=30
# Random text used to protect verification codes. Change it on the real server.
APP_SECRET=change-this-to-a-long-random-text

# ---- MongoDB (Atlas) ----
# Full connection link. The password is already filled in.
# On Railway: add the same two values as Variables.
MONGODB_URI=mongodb+srv://moabdel3al33_db_user:<db_password>@cluster0.cok1pqo.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=abdel3al

# ---- Email (verification codes) ----
# Gmail needs an "App password" (not your normal password):
# Google account -> Security -> 2-Step Verification -> App passwords.
# While SMTP_PASS is empty, codes are printed in the terminal and shown on the page (testing only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Online payment: PayPal Checkout (optional) ----
# developer.paypal.com -> Apps & Credentials -> Live -> Create App -> copy Client ID + Secret.
# Use the Sandbox keys with PAYPAL_MODE=sandbox to test without real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# ---- Card payment: Lemon Squeezy (optional, steps in Admin > Payments) ----
# API key: Settings > API.  Store ID: Settings > Stores.  Variant ID: the variant of one "Order" product.
# Webhook secret: the Signing secret of the webhook pointing to https://your-site/webhooks/lemonsqueezy (event order_created).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---- Google Drive for book PDFs (optional, see README) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Files ----
# Uploaded files are stored in MongoDB Atlas, not on the server, so nothing is needed here.
# UPLOAD_DIR is only read once at start-up to copy files left on the disk by older versions into the database.
UPLOAD_DIR=./data/uploads

# ---- First super admin (created once, change the password after logging in) ----
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin321
